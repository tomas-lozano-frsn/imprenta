<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Resumen de Ventas</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-logo">📦 Imprenta</a>
      <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/resumen">Resumen</a>
      </div>
    </div>
  </nav>

  <h1>Resumen de ventas</h1>

  <form method="GET" action="/resumen">
    <label for="cliente">Filtrar por cliente:</label>
    <input type="text" name="cliente" value="<%= cliente || '' %>">
    <button type="submit">Filtrar</button>
  </form>

  <h2>Mensual</h2>
  <table>
    <thead>
      <tr>
        <th>Mes</th>
        <th>Color</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% ventasMensuales.forEach(v => { %>
        <tr>
          <td><%= v.mes %></td>
          <td><%= v.color %></td>
          <td><%= v.total %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <h2>Anual</h2>
  <table>
    <thead>
      <tr>
        <th>Año</th>
        <th>Color</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% ventasAnuales.forEach(v => { %>
        <tr>
          <td><%= v.anio %></td>
          <td><%= v.color %></td>
          <td><%= v.total %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

</body>
</html>
