<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Imprenta</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h1>🧱 Imprenta</h1>
    <nav>
      <a href="/">Inicio</a>
      <a href="/resumen">Resumen</a>
    </nav>
  </header>

  <main>
    <h2>Registrar venta</h2>
    <form action="/vender" method="POST">
      <label for="cliente">Cliente:</label>
      <input type="text" id="cliente" name="cliente" required>

      <table>
        <tr>
          <th>Color</th>
          <th>Stock actual</th>
          <th>Cantidad a vender</th>
        </tr>
        <% productos.forEach(producto => { %>
          <tr>
            <td><%= producto.color %></td>
            <td><%= producto.stock %></td>
            <td>
              <input type="number" name="cantidad[<%= producto.color %>]" min="0" value="0">
            </td>
          </tr>
        <% }); %>
      </table>

      <button type="submit">Registrar</button>
    </form>

    <h2>Agregar stock</h2>
    <form action="/agregar-stock" method="POST">
      <label for="color">Color:</label>
      <select name="color" id="color">
        <% productos.forEach(producto => { %>
          <option value="<%= producto.color %>"><%= producto.color %></option>
        <% }); %>
      </select>

      <label for="cantidad">Cantidad a agregar:</label>
      <input type="number" name="cantidad" id="cantidad" min="1">

      <button type="submit">Agregar stock</button>
    </form>

    <p><a href="/resumen">Ver resúmenes de ventas</a></p>
  </main>
</body>
</html>
